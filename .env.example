# Copia este archivo a .env y rellena los valores. El .env NUNCA se sube al
# repositorio (está en .gitignore) porque contiene secretos.

# Base de datos: SQLite en desarrollo, PostgreSQL en producción.
# OJO: en SQLite la ruta relativa se resuelve desde prisma/schema.prisma,
# por eso el "../db/". El archivo custom.db se crea al hacer db:push.
DATABASE_URL="file:../db/custom.db"

# Secreto de NextAuth (firma las sesiones). Genera uno propio con:
#   openssl rand -hex 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# URL pública de la app en producción. Obligatoria en Vercel para que el
# login funcione (ej. https://pacucurucu-dental-care.vercel.app).
# NEXTAUTH_URL="https://tu-proyecto.vercel.app"

# Usuario administrador que crea el seed (bun prisma/seed.ts).
# La contraseña se hashea al crearla; el seed no sobrescribe una contraseña
# que ya hayas cambiado manualmente desde el panel.
ADMIN_EMAIL="admin@tudominio.com"
ADMIN_PASSWORD="elige-una-contrasena-fuerte"
ADMIN_NAME="Dr. Nombre Apellido"

# Integraciones opcionales (ver docs/07-whatsapp-integration.md)
# WHATSAPP_ENABLED=false
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_ID=""
# STRIPE_ENABLED=false
